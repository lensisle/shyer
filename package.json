{
  "name": "shyer",
  "version": "0.1.0",
  "description": "Shyer – small, pluggable 2D game engine (now with WebGL + TypeScript)",
  "author": {
    "name": "camkida"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/camiloei/shyer"
  },
  "bugs": {
    "url": "https://github.com/camiloei/shyer/issues",
    "email": "camiloscamp@gmail.com"
  },
  "license": "MIT",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "clean": "rimraf dist lib es pgbuild",
    "build": "tsup",
    "dev": "tsup --watch",
    "play:build": "npm run build && rimraf playground/shyer && mkdir -p playground/shyer && cp -R dist/* playground/shyer/",
    "play:serve": "npm run play:build && npx http-server playground -c-1 -o"
  },
  "devDependencies": {
    "tsup": "^8.1.0",
    "typescript": "^5.6.2",
    "rimraf": "^5.0.5"
  },
  "tsup": {
    "entry": [
      "src/index.ts"
    ],
    "splitting": false,
    "sourcemap": true,
    "clean": true,
    "dts": true,
    "minify": true,
    "format": [
      "esm",
      "cjs",
      "iife"
    ],
    "globalName": "Shyer",
    "outDir": "dist"
  }
}
